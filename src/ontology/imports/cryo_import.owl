############################
#   Classes
############################

# Class: <https://w3id.org/pmd/cryo/CRYO_0000000> (unit cell)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000000> "unit cell"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000000> "Unit cell is a site which is a part of a crystal lattice and represents the smallest volume, from which the lattice can be constructed by translational displacements. Unit cell is characterized by the length of its sides and their angular relations."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000000> <http://purl.obolibrary.org/obo/BFO_0000029>)

# Class: <https://w3id.org/pmd/cryo/CRYO_0000001> (crystal lattice)

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/cryo/CRYO_0000001> "TODO: 
1. check if located in is meant to be used this way
2. Is there a better alternative to has part?"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000001> "crystal lattice"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000001> "Crystal lattice is a site which has unit cell as part and is location of a crystal. It represents a periodic array of points in space, which describe the arrangement of atoms or molecules in a crystal."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000001> <http://purl.obolibrary.org/obo/BFO_0000029>)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <https://w3id.org/pmd/cryo/CRYO_0000000>))

# Class: <https://w3id.org/pmd/cryo/CRYO_0000011> (crystallographic plane)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000011> "crystallographic plane"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000011> "Crystallographic plane is a fiat surface which is part of a crystal lattice and which is denoted by Miller indices of a plane."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000011> <http://purl.obolibrary.org/obo/BFO_0000146>)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000011> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <https://w3id.org/pmd/cryo/CRYO_0000001>))

# Class: <https://w3id.org/pmd/cryo/CRYO_0000012> (crystallographic direction)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000012> "crystallographic direction"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000012> "Crystallographic direction is a fiat line which is part of a crystal lattice and which is denoted by Miller indices of a direction."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000012> <http://purl.obolibrary.org/obo/BFO_0000142>)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000012> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <https://w3id.org/pmd/cryo/CRYO_0000001>))

# Class: <https://w3id.org/pmd/cryo/CRYO_0000017> (primitive unit cell)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000017> "primitive unit cell"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000017> "primitive unit cell is a unit cell that contains only single lattice point and has the smallest possible unit cell volume."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000017> <https://w3id.org/pmd/cryo/CRYO_0000000>)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000017> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <https://w3id.org/pmd/cryo/CRYO_0000405>))

# Class: <https://w3id.org/pmd/cryo/CRYO_0000018> (conventional unit cell)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000018> "conventional unit cell"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000018> "conventional unit cell is a unit cell with the full symmetry of the crystal lattice, i.e., it may contain more that one lattice point."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000018> <https://w3id.org/pmd/cryo/CRYO_0000000>)

# Class: <https://w3id.org/pmd/cryo/CRYO_0000025> (atomic plane)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000025> "atomic plane"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000025> "Atomic plane is a 2D fiat object part which has atoms as it parts and is located in some crystallogphic plane, i.e., the positions of atoms relative to each other are defined via the characterisitics of the crystallogphic plane."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000025> <http://purl.obolibrary.org/obo/BFO_0000024>)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000025> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CHEBI_33250>))
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000025> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001025> <https://w3id.org/pmd/cryo/CRYO_0000011>))

# Class: <https://w3id.org/pmd/cryo/CRYO_0000027> (lattice centering)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000027> "lattice centering"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000027> "Lattice centering is an intensive quality ofa crystal lattice which the geometric arrangement of lattice points in a unit cell. It is specified by one of the 4 lattice centering value."@en)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000027> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000027> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000080> <https://w3id.org/pmd/cryo/CRYO_0000001>))

# Class: <https://w3id.org/pmd/cryo/CRYO_0000028> (crystal system value)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000028> "crystal system value"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000028> "crystal system value is a categorical value specification which describes the grouping of
crystal system  based on the rotational and mirror symmetries of their actual atomic arrangements in the  crystal. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, trigonal, hexagonal, and cubic."@en)
EquivalentClasses(<https://w3id.org/pmd/cryo/CRYO_0000028> ObjectOneOf(<https://w3id.org/pmd/cryo/CRYO_0000029> <https://w3id.org/pmd/cryo/CRYO_0000030> <https://w3id.org/pmd/cryo/CRYO_0000031> <https://w3id.org/pmd/cryo/CRYO_0000032> <https://w3id.org/pmd/cryo/CRYO_0000034> <https://w3id.org/pmd/cryo/CRYO_0000035> <https://w3id.org/pmd/cryo/CRYO_0000391>))
SubClassOf(<https://w3id.org/pmd/cryo/CRYO_0000028> <http://purl.obolibrary.org/obo/OBI_0001930>)

# Class: <https://w3id.org/pmd/cryo/CRYO_0000036> (lattice centering value)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000036> "lattice centering value"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000036> "Lattice centering value is a categorical value specification which describes th geometric arrangement of lattice points in a unit cell with one of the values: primitive, body centered, face centered, base centered."@en)
